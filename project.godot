; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="构造一个我"
config/description="生物机械构装解谜建筑游戏"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/格式塔 (Gestalt)"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.08, 0.09, 0.12, 1)
config/custom_user_dir_name.windows="Godot/app_userdata/格式塔 (Gestalt)"
config/custom_user_dir_name.macos="Godot/app_userdata/格式塔 (Gestalt)"

[audio]

driver/output_latency.web=25

[autoload]

OperationManual="*res://scripts/ui/OperationManual.gd"
BGM="*res://scripts/core/MusicManager.gd"
SFX="*res://scripts/core/SoundManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/font.ttf"

